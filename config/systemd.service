[Unit]
Description=EcoGuard AI Environmental Monitoring Server
After=network.target mongod.service postgresql.service

[Service]
Type=simple
User=ecoguard
WorkingDirectory=/opt/ecoguard-ai-system
ExecStart=/usr/bin/node backend/api/server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production PORT=5000
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ecoguard-backend

[Install]
WantedBy=multi-user.target
