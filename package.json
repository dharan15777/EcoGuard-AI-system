{
  "name": "ecoguard-ai-system",
  "version": "1.0.0",
  "description": "Enterprise AI-powered Environmental Monitoring, Disaster Early Warning & IoT Sensor System",
  "main": "backend/api/server.js",
  "scripts": {
    "start": "node backend/api/server.js",
    "dev:backend": "node --watch backend/api/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "simulator": "node scripts/simulator.js",
    "test": "npm run test:all",
    "test:unit": "node tests/unit/riskCalculator.test.js && node tests/unit/alertService.test.js",
    "test:integration": "node tests/integration/api.test.js && node tests/integration/database.test.js",
    "test:e2e": "node tests/e2e/alerts.test.js && node tests/e2e/dashboard.test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "keywords": [
    "environmental-monitoring",
    "iot",
    "edge-ai",
    "disaster-prevention",
    "flood-warning",
    "fire-detection",
    "air-quality"
  ],
  "author": "EcoGuard AI Engineering Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  }
}
